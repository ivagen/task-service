# Single source of truth for Docker Compose and for the PHP container.
# Copy to `.env` (`make env`) and adjust.
#
# Compose reads this file for ${...} interpolation *and* passes the runtime
# values to the app container, so there is no second copy to keep in sync.

# --- Database -----------------------------------------------------------
# DB_HOST/DB_PORT are the values seen from inside the app container.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=task_service
DB_USER=task_service
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
# Host port for connecting to MySQL from your machine.
DB_HOST_PORT=3307

# --- Cache / Redis ------------------------------------------------------
# file | redis
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_HOST_PORT=6380

# --- Auth service -------------------------------------------------------
# host.docker.internal works out of the box on Docker Desktop and, thanks to
# the extra_hosts entry, on Linux too. If auth-service runs in Docker, prefer
# the shared network (see README) and use its service name instead, e.g.
# AUTH_SERVICE_URL=http://auth_service_nginx:8000
AUTH_SERVICE_URL=http://host.docker.internal:8000
AUTH_NETWORK=auth_service_default
AUTH_TIMEOUT=3
AUTH_CONNECT_TIMEOUT=2
# Seconds a validated token stays cached. A token revoked upstream remains
# usable here for up to this long. Set to 0 to disable caching.
AUTH_CACHE_TTL=60
# Extra attempts after the first (0 disables). Only connection failures and
# 502/503/504 are repeated — never a 401 and never a read timeout.
AUTH_RETRIES=1
AUTH_RETRY_DELAY_MS=100
# Hard ceiling for the whole token check, retries included. This is what bounds
# the worst case, not the per-attempt timeouts.
AUTH_TOTAL_TIMEOUT=5

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60

# --- Application --------------------------------------------------------
YII_DEBUG=false
YII_ENV=prod

# --- HTTP ---------------------------------------------------------------
APP_HOST_PORT=8002
