{
    "name": "task-service/task-service",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "yiisoft/yii2": "~2.0.0",
        "yiisoft/yii2-redis": "~2.0.0",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.0",
        "bower-asset/jquery": "^3.7",
        "bower-asset/inputmask": "^5.0",
        "bower-asset/punycode": "^2.3",
        "bower-asset/yii2-pjax": "^2.0.9"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        },
        "exclude-from-classmap": [
            "/migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --dry-run --diff",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit --testsuite Feature",
        "test:integration": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --testsuite Feature --coverage-clover=build/clover.xml",
            "php tests/coverage-check.php build/clover.xml 85"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "asset-installer-paths": {
            "npm-asset-dir": "vendor/npm-asset",
            "bower-asset-dir": "vendor/bower-asset"
        }
    }
}
