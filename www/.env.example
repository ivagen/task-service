# Runtime configuration for running the app WITHOUT Docker (php -S, local
# MySQL/Redis, phpunit against a real database).
#
# Under Docker these values come from the ROOT .env via docker-compose.yml —
# see ../.env.example. This file is loaded by Dotenv only if it exists, and
# real environment variables always win over it.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=task_service
DB_USER=root
DB_PASSWORD=

CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AUTH_SERVICE_URL=http://localhost:8000
AUTH_TIMEOUT=3
AUTH_CONNECT_TIMEOUT=2
AUTH_CACHE_TTL=60

RATE_LIMIT=60
RATE_LIMIT_WINDOW=60

YII_DEBUG=true
YII_ENV=dev
